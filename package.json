{
  "name": "ycy-ai-controller-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/stamp-build.mjs",
    "postinstall": "node scripts/patch-ble-plugin.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs",
    "check": "npm test && npm run build",
    "cap:sync": "npx cap sync android",
    "build:apk": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug && cd ..",
    "update:publish": "node scripts/publish-update.mjs",
    "ota:build": "node scripts/build-ota-bundle.mjs",
    "release:upload": "node scripts/upload-release.mjs",
    "release:publish": "npm run build && npm run ota:build && npm run release:upload"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@capgo/capacitor-updater": "^8.51.21",
    "crypto-js": "^4.2.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capgo/cli": "^8.61.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.4",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
